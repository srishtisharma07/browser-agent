# ─────────────────────────────────────────────
# AI Browser Agent — Example Environment File
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit a .env file containing real secrets.

# ── Backend ──────────────────────────────────
# Host / port for Uvicorn
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── Frontend → Backend connection ────────────
# Base URL the React app uses when calling the backend API.
# Leave EMPTY in development — the Vite dev proxy forwards /api/* to
# http://127.0.0.1:8000 automatically (see vite.config.js).
# Set to http://localhost:8000 if you want direct calls (no proxy).
VITE_API_BASE_URL=

# ── Frontend ─────────────────────────────────
# Vite dev server port (default: 5173)
VITE_PORT=5173
# Base URL that the React app uses to reach the backend API
VITE_API_BASE_URL=http://localhost:8000

# ── Future: Gemini / Google AI ───────────────
# (Not used yet – Phase 1)
# GEMINI_API_KEY=your-key-here

# ── Future: LangGraph / LangSmith ────────────
# (Not used yet – Phase 1)
# LANGCHAIN_API_KEY=your-key-here
# LANGCHAIN_PROJECT=ai-browser-agent

# ── Future: Playwright / Browser ─────────────
# (Not used yet – Phase 1)
# PLAYWRIGHT_HEADLESS=true
